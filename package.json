{
  "name": "shreyas-portfolio",
  "private": true,
  "version": "1.0.0",
  "description": "Modern MERN portfolio for Shreyas R Achar",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "preview": "vite preview --config client/vite.config.js",
    "start": "node server/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Achuu-codes/Portfolio.git"
  },
  "keywords": [
    "portfolio",
    "mern",
    "react",
    "express",
    "mongodb"
  ],
  "author": "Shreyas R Achar",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "mongoose": "^9.3.3",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "vite": "^8.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
